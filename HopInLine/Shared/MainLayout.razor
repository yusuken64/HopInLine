@inherits LayoutComponentBase

<CascadingValue Value="OverlayService">
    <Overlay IsVisible="@isOverlayVisible" />
    <ConfirmDialog />

<PageTitle>HopInLine</PageTitle>

<div class="app-shell">
<header class="top-row">
    <NavMenu />
    @* Pages put their own title and actions here (the line page: name, head count, Invite, Settings) *@
    <SectionOutlet SectionName="top-bar" />
</header>

<main>
    <article class="content">
        @Body
    </article>
</main>
</div>
</CascadingValue>

@code {
    private bool isOverlayVisible;

    [Inject] public OverlayService OverlayService { get; set; } = default!;

    protected override void OnInitialized()
    {
        OverlayService.OnShowOverlay += ShowOverlay;
        OverlayService.OnHideOverlay += HideOverlay;
    }

    private void ShowOverlay()
    {
        isOverlayVisible = true;
        StateHasChanged(); // Notify Blazor to re-render
    }

    private void HideOverlay()
    {
        isOverlayVisible = false;
        StateHasChanged(); // Notify Blazor to re-render
    }
}