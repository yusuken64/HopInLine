@implements IDisposable
@inject ConfirmService ConfirmService

@if (ConfirmService.IsVisible)
{
    <div class="dialog-backdrop">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-message">
            <div class="dialog-icon" aria-hidden="true">⚠️</div>
            <h2 class="dialog-title" id="confirm-message">@ConfirmService.Message</h2>
            <div class="dialog-actions">
                <button class="btn btn-secondary btn-lg" @onclick="() => ConfirmService.Cancel()">No, go back</button>
                <button class="btn btn-danger btn-lg" @onclick="() => ConfirmService.Confirm()">Yes</button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ConfirmService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConfirmService.OnChange -= HandleChange;
    }
}
