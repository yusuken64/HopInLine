@using Microsoft.AspNetCore.Components.Web

@* A labeled "More" button that opens a list of big menu items. *@
<div class="kebab-menu @(OpenUp ? "kebab-up" : "") @(AlignStart ? "kebab-start" : "")">
    <button
        @onclick="() => isOpen = !isOpen"
        @onkeydown="HandleKeyDown"
        aria-haspopup="menu"
        aria-expanded="@(isOpen ? "true" : "false")"
        aria-label="@TriggerAriaLabel"
        disabled="@Disabled"
        class="@TriggerClass kebab-trigger @(isOpen ? "open" : "")">
        @if (TriggerContent is not null)
        {
            @TriggerContent
        }
        else
        {
            @TriggerLabel
        }
    </button>

    @if (isOpen)
    {
        <button class="kebab-backdrop" @onclick="() => isOpen = false" aria-hidden="true" tabindex="-1"></button>
        <ul class="kebab-popover" role="menu" @onkeydown="HandleKeyDown">
            @foreach (var item in Items)
            {
                <li role="none">
                    <button
                        role="menuitem"
                        class="kebab-item @(item.IsDangerous ? "kebab-item-danger" : "")"
                        aria-label="@(item.AriaLabel ?? item.Label)"
                        @onclick="() => HandleItemClick(item)">
                        @item.Label
                    </button>
                </li>
            }
            <li role="none">
                <button role="menuitem" class="kebab-item kebab-item-close" @onclick="() => isOpen = false">✕ Close menu</button>
            </li>
        </ul>
    }
</div>

@code {
    [Parameter]
    public List<KebabMenuItem> Items { get; set; } = new();

    [Parameter]
    public string TriggerAriaLabel { get; set; } = "More actions";

    /// <summary>Visible text on the button. Spelled out so nobody has to guess what "⋮" means.</summary>
    [Parameter]
    public string TriggerLabel { get; set; } = "⋯ More";

    /// <summary>Optional richer trigger content. Replaces <see cref="TriggerLabel"/> when set.</summary>
    [Parameter]
    public RenderFragment? TriggerContent { get; set; }

    [Parameter]
    public string TriggerClass { get; set; } = "btn btn-secondary btn-sm";

    /// <summary>Opens the menu above the trigger, for menus at the bottom of the screen.</summary>
    [Parameter]
    public bool OpenUp { get; set; }

    /// <summary>Lines the menu up with the trigger's left edge instead of its right edge.</summary>
    [Parameter]
    public bool AlignStart { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool isOpen;

    private async Task HandleItemClick(KebabMenuItem item)
    {
        isOpen = false;
        await item.OnClick.InvokeAsync(null);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            isOpen = false;
        }
    }
}
