@using HopInLine.Data.Line
@using HopInLine.Shared

<!-- RemovedParticipantCard.razor -->
<div class="participant-card">
    <span class="participant-badge" style="background-color: @BackgroundColor;" aria-hidden="true"></span>
    <div class="participant-info">
        <span>@Name — @TurnCount turn(s)</span>
        <p>@Description</p>
    </div>
    <KebabMenu TriggerAriaLabel="@($"Actions for {Name}")" Items="@GetMenuItems()" />
</div>


@code {
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public string Description { get; set; } = default!;
    [Parameter] public string Id { get; set; } = default!;
    [Parameter] public string BackgroundColor { get; set; } = default!;
    [Parameter] public int TurnCount { get; set; }

    [Parameter] public EventCallback OnReAdd { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private async Task ReAdd() => await OnReAdd.InvokeAsync(null);
    private async Task Delete() => await OnDelete.InvokeAsync(null);

    private List<KebabMenuItem> GetMenuItems() => new()
    {
        new KebabMenuItem
        {
            Label = "Re-Add",
            AriaLabel = $"Add {Name} back to the line",
            OnClick = EventCallback.Factory.Create(this, ReAdd),
            IsDangerous = false
        },
        new KebabMenuItem
        {
            Label = "Delete",
            AriaLabel = $"Permanently delete {Name}",
            OnClick = EventCallback.Factory.Create(this, Delete),
            IsDangerous = true
        }
    };
}
