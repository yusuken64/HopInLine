@using HopInLine.Data.Line

<!-- RemovedParticipantCard.razor -->
<div class="participant-card" style="background-color: @BackgroundColor; color: @ParticipantFactory.GetForegroundColor(@BackgroundColor)">
    <div class="participant-info">
        <span>@Name (@TurnCount)</span>
        <p>@Description</p>
    </div>
    <div class="participant-actions">
        <button @onclick="ReAdd" aria-label="Add @Name back to the line">Re-Add</button>
        <button @onclick="Delete" aria-label="Permanently delete @Name">Delete</button>
    </div>
</div>


@code {
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public string Description { get; set; } = default!;
    [Parameter] public string Id { get; set; } = default!;
    [Parameter] public string BackgroundColor { get; set; } = default!;
    [Parameter] public int TurnCount { get; set; }


    [Parameter] public EventCallback OnReAdd { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private async Task ReAdd() => await OnReAdd.InvokeAsync(null);
    private async Task Delete() => await OnDelete.InvokeAsync(null);
}
