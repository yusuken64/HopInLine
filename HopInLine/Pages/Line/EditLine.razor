@page "/manage/{LineId}/{ManageToken}/edit"
@using HopInLine.Data.Line;
@using Microsoft.EntityFrameworkCore;
@inject IJSRuntime JS
@inject ILogger<EditLine> Logger
@if (permissionDenied)
{
    <div class="alert alert-danger" role="alert">
        <p>You do not have permission to edit this line.</p>
    </div>
}
else if (loadedLine == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit line</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div>
        <p>To edit the line, please update the following details:</p>
    </div>

    <div class="form-group">
        <label for="lineName">Line Name:</label>
        <input type="text" id="lineName" @bind="editModel.Name" class="form-control" placeholder="Enter line name" />
    </div>

    <div class="form-group">
        <label for="description">Description:</label>
        <textarea id="description" @bind="editModel.Description" class="form-control" placeholder="Enter description"></textarea>
    </div>

    <div class="form-group">
        <label for="autoAdvanceLine">Timer Advance:</label>
        <input type="checkbox" id="autoAdvanceLine" @bind="editModel.AutoAdvanceLine" class="form-check-input" />
    </div>

    <div class="form-group">
        <label for="autoRestartTimerOnAdvance">Auto Start Timer after Advancing:</label>
        <input type="checkbox" id="autoRestartTimerOnAdvance" @bind="editModel.AutoRestartTimerOnAdvance" class="form-check-input" />
    </div>

    <div class="form-group">
        <label for="autoAdvanceMinutes">Auto-Advance Interval (Minutes):</label>
        <input type="number"
               id="autoAdvanceMinutes"
               @bind="editModel.AutoAdvanceIntervalMinutes"
               class="form-control"
               disabled="@(!editModel.AutoAdvanceLine)"
               min="1"
               max="1440"
               step="1" />
    </div>

    <div class="form-group">
        <label for="graceSeconds">Grace time between turns (Seconds):</label>
        <input type="number"
               id="graceSeconds"
               @bind="editModel.GraceSeconds"
               class="form-control"
               disabled="@(!editModel.AutoAdvanceLine)"
               min="0"
               step="1" />
    </div>

    <div class="form-group">
        <label for="startCountdownSeconds">Start countdown (Seconds):</label>
        <input type="number"
               id="startCountdownSeconds"
               @bind="editModel.StartCountdownSeconds"
               class="form-control"
               disabled="@(!editModel.AutoAdvanceLine)"
               min="0"
               step="1" />
    </div>

    <div class="form-group">
        <label for="autoReAdd">Auto Re-Add:</label>
        <input type="checkbox" id="autoReAdd" @bind="editModel.AutoReAdd" class="form-check-input" />
    </div>

    <button @onclick="SaveChanges" class="btn btn-primary">Save</button>
    <button @onclick="Cancel" class="btn btn-secondary">Cancel</button>
    <button @onclick="Delete" class="btn btn-danger">Delete</button>

}
@code {
    [Inject]
    private ILineService LineServiceInterface { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    [Inject]
    private ConfirmService ConfirmService { get; set; } = null!;

    [Parameter]
    public string LineId { get; set; } = string.Empty;

    [Parameter]
    public string? ManageToken { get; set; }

    private LineDto? loadedLine;
    private EditModel editModel = new();
    private string errorMessage = string.Empty;
    private bool permissionDenied = false;

    private class EditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool AutoAdvanceLine { get; set; }
        public bool AutoReAdd { get; set; }
        public bool AutoRestartTimerOnAdvance { get; set; }
        public int AutoAdvanceIntervalMinutes { get; set; }
        public int GraceSeconds { get; set; }
        public int StartCountdownSeconds { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Validate the manage token first
            bool isAuthorized = await LineServiceInterface.ValidateManageTokenAsync(LineId, ManageToken ?? string.Empty);
            if (!isAuthorized)
            {
                permissionDenied = true;
                return;
            }

            loadedLine = await LineServiceInterface.GetLineAsync(LineId);

            if (loadedLine == null)
            {
                NavigationManager.NavigateTo("/not-found");
                return;
            }

            // Load values into detached edit model
            editModel = new EditModel
            {
                Name = loadedLine.Name,
                Description = loadedLine.Description,
                AutoAdvanceLine = loadedLine.AutoAdvanceLine,
                AutoReAdd = loadedLine.AutoReAdd,
                AutoRestartTimerOnAdvance = loadedLine.AutoRestartTimerOnAdvance,
                AutoAdvanceIntervalMinutes = (int)loadedLine.AutoAdvanceInterval.TotalMinutes,
                GraceSeconds = (int)loadedLine.GraceTime.TotalSeconds,
                StartCountdownSeconds = (int)loadedLine.StartCountdown.TotalSeconds
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error loading line: {ex.Message}");
            NavigationManager.NavigateTo("/not-found");
        }
    }

    private async Task SaveChanges()
    {
        // Validate interval bounds
        if (editModel.AutoAdvanceIntervalMinutes < 1 || editModel.AutoAdvanceIntervalMinutes > 1440)
        {
            errorMessage = "Auto-Advance Interval must be between 1 and 1440 minutes.";
            return;
        }

        var intervalSeconds = editModel.AutoAdvanceIntervalMinutes * 60;
        if (editModel.AutoAdvanceLine
            && (editModel.GraceSeconds < 0 || editModel.GraceSeconds >= intervalSeconds
                || editModel.StartCountdownSeconds < 0 || editModel.StartCountdownSeconds >= intervalSeconds))
        {
            errorMessage = "Grace time and start countdown must be 0 or more and less than the interval.";
            return;
        }

        try
        {
            await LineServiceInterface.UpdateLineAsync(
                LineId,
                ManageToken ?? string.Empty,
                editModel.Name,
                editModel.Description,
                editModel.AutoAdvanceLine,
                editModel.AutoReAdd,
                editModel.AutoRestartTimerOnAdvance,
                TimeSpan.FromMinutes(editModel.AutoAdvanceIntervalMinutes),
                TimeSpan.FromSeconds(editModel.GraceSeconds),
                TimeSpan.FromSeconds(editModel.StartCountdownSeconds)
            );

            NavigationManager.NavigateTo($"/manage/{LineId}/{ManageToken}");
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogError(ex, "Concurrency conflict saving changes for line {LineId}", LineId);
            errorMessage = "Someone else just updated this line — please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save changes for line {LineId}", LineId);
            errorMessage = "Failed to save changes. Please try again.";
        }
    }

    private async Task Delete()
    {
        bool confirmed = await ConfirmService.ConfirmAsync("Delete this line permanently? Everyone in it will lose their place.");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await LineServiceInterface.DeleteLineAsync(LineId, ManageToken ?? string.Empty);
            NavigationManager.NavigateTo("/");
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogError(ex, "Concurrency conflict deleting line {LineId}", LineId);
            errorMessage = "Someone else just updated this line — please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete line {LineId}", LineId);
            errorMessage = "Failed to delete this line. Please try again.";
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo($"/manage/{LineId}/{ManageToken}");
    }
}
