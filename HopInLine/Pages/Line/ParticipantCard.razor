@using HopInLine.Data.Line
@using HopInLine.Shared

<!-- ParticipantCard.razor -->
<div class="participant-card @(IsCurrentTurn ? "participant-card-hero" : "")">
    <span class="participant-badge" style="background-color: @BackgroundColor;" aria-hidden="true"></span>
    <div class="participant-info">
        <div>
            <span>@Name — @TurnCount turn(s)</span>
            @if (IsCurrentTurn)
            {
                <span class="participant-hero-badge">Up now</span>
            }
        </div>
        <p>@Description</p>
    </div>
    <KebabMenu TriggerAriaLabel="@($"Actions for {Name}")" Items="@GetMenuItems()" />
</div>


@code {
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public string Description { get; set; } = default!;
    [Parameter] public string Id { get; set; } = default!;
    [Parameter] public string BackgroundColor { get; set; } = default!;
    [Parameter] public int TurnCount { get; set; }
    [Parameter] public bool IsCurrentTurn { get; set; }

    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private async Task MoveUp() => await OnMoveUp.InvokeAsync(null);
    private async Task MoveDown() => await OnMoveDown.InvokeAsync(null);
    private async Task Remove() => await OnRemove.InvokeAsync(null);

    private List<KebabMenuItem> GetMenuItems() => new()
    {
        new KebabMenuItem
        {
            Label = "Move Up",
            AriaLabel = $"Move {Name} up",
            OnClick = EventCallback.Factory.Create(this, MoveUp),
            IsDangerous = false
        },
        new KebabMenuItem
        {
            Label = "Move Down",
            AriaLabel = $"Move {Name} down",
            OnClick = EventCallback.Factory.Create(this, MoveDown),
            IsDangerous = false
        },
        new KebabMenuItem
        {
            Label = "Remove",
            AriaLabel = $"Remove {Name} from the line",
            OnClick = EventCallback.Factory.Create(this, Remove),
            IsDangerous = true
        }
    };
}
