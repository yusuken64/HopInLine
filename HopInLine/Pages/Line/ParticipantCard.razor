@using HopInLine.Data.Line

<!-- ParticipantCard.razor -->
<div class="participant-card" style="background-color: @BackgroundColor; color: @ParticipantFactory.GetForegroundColor(@BackgroundColor)">
    <div class="participant-info">
        <span>@Name (@TurnCount)</span>
        <p>@Description</p>
    </div>
    <div class="participant-actions">
        <button @onclick="MoveUp" aria-label="Move @Name up">Move Up</button>
        <button @onclick="MoveDown" aria-label="Move @Name down">Move Down</button>
        <button @onclick="Remove" aria-label="Remove @Name from the line">Remove</button>
    </div>
</div>


@code {
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public string Description { get; set; } = default!;
    [Parameter] public string Id { get; set; } = default!;
    [Parameter] public string BackgroundColor { get; set; } = default!;
    [Parameter] public int TurnCount { get; set; }


    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private async Task MoveUp() => await OnMoveUp.InvokeAsync(null);
    private async Task MoveDown() => await OnMoveDown.InvokeAsync(null);
    private async Task Remove() => await OnRemove.InvokeAsync(null);
}
