@page "/view-line/{LineId}"
@page "/manage/{LineId}/{ManageToken}"
@using HopInLine.Data.Line;
@using Microsoft.EntityFrameworkCore;
@implements IAsyncDisposable

@if (line == null)
{
	if (string.IsNullOrEmpty(errorMessage))
	{
		<div class="big-message">
			<div class="big-message-icon" aria-hidden="true">⏳</div>
			<p><strong>Loading…</strong></p>
		</div>
	}
	else
	{
		<div class="page">
			<div class="page-card big-message" role="alert">
				<div class="big-message-icon" aria-hidden="true">🤔</div>
				<h1>@errorMessage</h1>
				<p>Check the code, or start a new line from the home page.</p>
				<div class="page-actions">
					<a href="/" class="btn btn-warning btn-lg">🏠 Go to the home page</a>
				</div>
			</div>
		</div>
	}
}
else
{
	var queue = line.Participants.OrderBy(p => p.Position).ToList();
	var firstActive = queue.FirstOrDefault(p => !p.Removed);
	// The big board (clock or "Now up" sign). On wide screens it sits beside the list.
	var hasStage = (line.AutoAdvanceLine && queue.Count > 0) || (!line.AutoAdvanceLine && firstActive is not null);

	@if (panelOpen)
	{
		<div class="side-panel-backdrop" @onclick="ClosePanel" aria-hidden="true"></div>
	}

	<aside class="side-panel @(panelOpen ? "open" : "")" aria-label="@(panelTab == PanelTab.Invite ? "Invite people" : "Settings")">
		<div class="side-panel-header">
			<h2 class="side-panel-title">@(panelTab == PanelTab.Invite ? "📣 Invite people" : "⚙️ Settings")</h2>
			<button class="btn btn-secondary btn-sm" @onclick="ClosePanel">✕ Close</button>
		</div>

		@if (canManage)
		{
			<nav class="side-panel-tabs" role="tablist" aria-label="Panel sections">
				<button role="tab" aria-selected="@(panelTab == PanelTab.Invite ? "true" : "false")"
						class="side-panel-tab @(panelTab == PanelTab.Invite ? "active" : "")"
						@onclick="() => panelTab = PanelTab.Invite">
					📣 Invite
				</button>
				<button role="tab" aria-selected="@(panelTab == PanelTab.Settings ? "true" : "false")"
						class="side-panel-tab @(panelTab == PanelTab.Settings ? "active" : "")"
						@onclick="() => panelTab = PanelTab.Settings">
					⚙️ Settings
				</button>
			</nav>
		}

		<div class="side-panel-body">
			@if (panelTab == PanelTab.Invite)
			{
				<section class="panel-section">
					<h3 class="panel-heading">Tell people this code</h3>
					<p class="join-code" aria-label="Line code">@line.Id</p>
					<p class="panel-text">They type it on the HopInLine home page.</p>
				</section>

				<section class="panel-section">
					<h3 class="panel-heading">Or send them the link</h3>
					<input class="form-control panel-link" readonly value="@ShareLink" aria-label="Join link" />
					<button @onclick="CopyShareLink" class="btn btn-primary btn-wide">@(shareLinkCopied ? "✅ Copied!" : "📋 Copy link")</button>
				</section>

				@if (canManage)
				{
					<section class="panel-section">
						<h3 class="panel-heading">➕ Add someone</h3>
						<p class="panel-text">For people who don't have a phone with them.</p>
						<form class="panel-add" @onsubmit="AddOther" @onsubmit:preventDefault>
							<input @bind="newParticipant" placeholder="Their name" maxlength="60" class="form-control" disabled="@busy" aria-label="Name to add" />
							<button type="submit" class="btn btn-success" disabled="@busy">Add</button>
						</form>
					</section>

					<section class="panel-section panel-warning">
						<h3 class="panel-heading">🔑 Your manager link</h3>
						<p class="panel-text">This link lets you run the line, and it's the only way back in. Bookmark it or save it somewhere safe. <strong>Don't share it.</strong></p>
						<button @onclick="CopyManageLink" class="btn btn-secondary btn-wide">@(manageLinkCopied ? "✅ Copied!" : "📋 Copy manager link")</button>
					</section>
				}
			}
			else if (panelTab == PanelTab.Settings && canManage)
			{
				@if (HasTimer)
				{
					<section class="panel-section">
						<h3 class="panel-heading">⏱️ Timer</h3>
						<p class="panel-text">Each turn lasts @DurationFormat.Humanize(line.AutoAdvanceInterval).</p>
						@TimerControls
					</section>
				}

				<section class="panel-section">
					<h3 class="panel-heading">✏️ Line settings</h3>
					<p class="panel-text">Change the name, the timer, or rotation.</p>
					<button @onclick="Edit" class="btn btn-secondary btn-wide" disabled="@busy">✏️ Change settings</button>
				</section>

				<section class="panel-section panel-danger">
					<h3 class="panel-heading">Danger zone</h3>
					<p class="panel-text">Deleting removes the line and everyone in it. You can't undo this.</p>
					<button @onclick="DeleteLineAsync" class="btn btn-danger btn-wide" disabled="@busy">🗑️ Delete line</button>
				</section>
			}
		</div>
	</aside>

	<div class="view-line-shell @(panelOpen ? "panel-open" : "") @(hasStage ? "has-stage" : "")">
		<div class="page view-line-content">
			<header class="line-header">
				<h1 class="page-title line-title">@line.Name</h1>
				@if (!string.IsNullOrWhiteSpace(line.Description))
				{
					<p class="line-description">@line.Description</p>
				}
				<p class="line-count">👥 @PeopleText(queue.Count)</p>
				<div class="line-header-actions">
					<button class="btn btn-primary" @onclick="() => OpenPanel(PanelTab.Invite)"
							aria-expanded="@(panelOpen && panelTab == PanelTab.Invite ? "true" : "false")">
						📣 Invite people
					</button>
					@if (canManage)
					{
						<button class="btn btn-secondary" @onclick="() => OpenPanel(PanelTab.Settings)"
								aria-expanded="@(panelOpen && panelTab == PanelTab.Settings ? "true" : "false")">
							⚙️ Settings
						</button>
					}
				</div>
			</header>

			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger" role="alert">@errorMessage</div>
			}

			<div class="line-body @(hasStage ? "has-stage" : "")">
			<div class="line-stage">
			@if (line.AutoAdvanceLine && queue.Count > 0)
			{
				<section class="scoreboard @(line.IsPaused ? "paused" : "")" aria-label="Turn timer">
					@if (firstActive is not null)
					{
						<div class="scoreboard-label">Now up</div>
						<div class="scoreboard-name">@firstActive.Name</div>
					}
					<div class="scoreboard-clock" id="countdown-@line.Id" role="timer">@GetTimeLeftDisplay()</div>
					<div class="scoreboard-status">
						<span class="scoreboard-light" aria-hidden="true"></span>
						<span id="status-@line.Id">@GetStatusLabel()</span>
					</div>
				</section>
				@if (canManage && HasTimer)
				{
					<div class="scoreboard-controls">
						@TimerControls
					</div>
				}
			}
			else if (!line.AutoAdvanceLine && firstActive is not null)
			{
				<section class="scoreboard scoreboard-simple" aria-label="Now up">
					<div class="scoreboard-label">Now up</div>
					<div class="scoreboard-name">@firstActive.Name</div>
				</section>
			}
			</div>

			<div class="line-list">
			<section class="page-card queue-card" aria-labelledby="queue-heading">
				<h2 id="queue-heading" class="queue-heading">Who's in line</h2>
				@if (queue.Count == 0)
				{
					<div class="queue-empty">
						<div class="queue-empty-icon" aria-hidden="true">🦗</div>
						<p class="queue-empty-title">Nobody's in line yet.</p>
						<p>Press <strong>🙋 Hop in line!</strong> at the bottom to go first.</p>
						@if (canManage)
						{
							<p>Or use <strong>📣 Invite people</strong> to add someone.</p>
						}
					</div>
				}
				else
				{
					<ol class="queue-list">
						@for (int i = 0; i < queue.Count; i++)
						{
							var participant = queue[i];
							<ParticipantCard @key="participant.Id"
								Name="@participant.Name"
								Description="@participant.Description"
								Id="@participant.Id"
								BackgroundColor="@participant.Color"
								TurnCount="@participant.TurnCount"
								IsCurrentTurn="@(participant.Id == firstActive?.Id)"
								Place="@(i + 1)"
								IsMe="@(participant.Id == myParticipantId)"
								CanManage="@canManage"
								CanMoveUp="@(i > 0)"
								CanMoveDown="@(i < queue.Count - 1)"
								Disabled="@busy"
								OnMoveUp="@(async () => await MoveParticipantUp(participant))"
								OnMoveDown="@(async () => await MoveParticipantDown(participant))"
								OnMoveToFront="@(async () => await MoveParticipantTo(participant, 0))"
								OnMoveToNext="@(async () => await MoveParticipantTo(participant, 1))"
								OnMoveToBack="@(async () => await MoveParticipantTo(participant, int.MaxValue))"
								OnRename="@(() => OpenRenamePrompt(participant))"
								OnEditNote="@(() => OpenNotePrompt(participant, isSelf: false))"
								OnRemove="@(async () => await RemoveParticipant(participant))" />
						}
					</ol>
				}
			</section>

			<section class="page-card history-card" aria-labelledby="history-heading">
				<div class="history-header">
					<h2 id="history-heading" class="history-heading">
						Out of line
						@if (line.RemovedParticipants is { Count: > 0 })
						{
							<span class="history-count">(@line.RemovedParticipants.Count)</span>
						}
					</h2>
					<button type="button" class="btn btn-secondary btn-sm" @onclick="() => historyCollapsed = !historyCollapsed"
							aria-expanded="@(historyCollapsed ? "false" : "true")" aria-controls="history-list">
						@(historyCollapsed ? "▸ Show" : "▾ Hide")
					</button>
				</div>
				@if (!historyCollapsed)
				{
					<div id="history-list">
						@if (line.RemovedParticipants == null || line.RemovedParticipants.Count == 0)
						{
							<p class="history-empty">People who had their turn, left, or were removed show up here.</p>
						}
						else
						{
							<ul class="queue-list">
								@foreach (var participant in line.RemovedParticipants.OrderBy(x => x.Position))
								{
									<RemovedParticipantCard @key="participant.Id"
										Name="@participant.Name"
										Description="@participant.Description"
										Id="@participant.Id"
										BackgroundColor="@participant.Color"
										TurnCount="@participant.TurnCount"
										CanManage="@canManage"
										Disabled="@busy"
										OnReAdd="@(async () => await ReAddRemovedParticipant(participant))"
										OnDelete="@(async () => await DeleteRemovedParticipant(participant))" />
								}
							</ul>
						}
					</div>
				}
			</section>
			</div>
			</div>
		</div>

		<div class="toolbar">
			<div class="toolbar-inner">
				<div class="toolbar-me">
					<div class="toolbar-who">
						<span class="toolbar-label">You are</span>
						<span class="toolbar-value">@(myName ?? "…")</span>
						<button @onclick="OpenNamePrompt" class="btn btn-secondary btn-sm">✏️ Change name</button>
					</div>
					@if (MyPosition is int position)
					{
						<div class="toolbar-place @(position == 1 ? "is-up" : "")">
							@if (position == 1)
							{
								<span class="toolbar-value">🎉 It's your turn!</span>
							}
							else
							{
								<span class="toolbar-label">Your place</span>
								<span class="toolbar-value">#@position</span>
								<span class="toolbar-ahead">@AheadText(position - 1)</span>
							}
						</div>
						<button @onclick="OpenOwnNotePrompt" class="btn btn-secondary" disabled="@busy">📝 My note</button>
						<button @onclick="LeaveLine" class="btn btn-secondary" disabled="@busy">👋 Leave line</button>
					}
					else
					{
						<button @onclick="JoinLine" class="btn btn-success btn-lg toolbar-join" disabled="@(busy || myName is null)">🙋 Hop in line!</button>
					}
				</div>
				@if (canManage)
				{
					<button @onclick="AdvanceLine" class="btn btn-warning btn-lg toolbar-advance" disabled="@busy">Next person ▶</button>
				}
			</div>
		</div>
	</div>

	@if (renameTarget is not null)
	{
		<div class="dialog-backdrop">
			<form class="dialog" role="dialog" aria-modal="true" aria-labelledby="rename-title"
				  @onsubmit="SaveRename" @onsubmit:preventDefault>
				<div class="dialog-icon" aria-hidden="true">✏️</div>
				<h2 class="dialog-title" id="rename-title">Rename @renameTarget.Name</h2>
				<p class="dialog-text">Everyone in the line will see the new name.</p>
				@if (!string.IsNullOrEmpty(renameError))
				{
					<div class="alert alert-danger" role="alert">@renameError</div>
				}
				<input @bind="renameInput" class="form-control dialog-input" maxlength="60" required autofocus aria-label="New name" />
				<div class="dialog-actions">
					<button type="button" @onclick="CloseRenamePrompt" class="btn btn-secondary btn-lg">✕ Cancel</button>
					<button type="submit" class="btn btn-success btn-lg" disabled="@busy">✓ Save</button>
				</div>
			</form>
		</div>
	}

	@if (noteTarget is not null)
	{
		<div class="dialog-backdrop">
			<form class="dialog" role="dialog" aria-modal="true" aria-labelledby="note-title"
				  @onsubmit="SaveNote" @onsubmit:preventDefault>
				<div class="dialog-icon" aria-hidden="true">📝</div>
				<h2 class="dialog-title" id="note-title">@(noteIsSelf ? "Your note" : $"Note for {noteTarget.Name}")</h2>
				<p class="dialog-text">Everyone in the line will see it. Leave it blank to remove it.</p>
				@if (!string.IsNullOrEmpty(noteError))
				{
					<div class="alert alert-danger" role="alert">@noteError</div>
				}
				<textarea @bind="noteInput" class="form-control dialog-input note-input" maxlength="200" rows="3" autofocus
						  placeholder="@(noteIsSelf ? "e.g. Question about homework 3" : "e.g. Needs help with setup")" aria-label="Note"></textarea>
				<div class="dialog-actions">
					<button type="button" @onclick="CloseNotePrompt" class="btn btn-secondary btn-lg">✕ Cancel</button>
					<button type="submit" class="btn btn-success btn-lg" disabled="@busy">✓ Save</button>
				</div>
			</form>
		</div>
	}

	@if (showNamePrompt)
	{
		<div class="dialog-backdrop">
			<form class="dialog" role="dialog" aria-modal="true" aria-labelledby="name-prompt-title"
				  @onsubmit="SaveName" @onsubmit:preventDefault>
				<div class="dialog-icon" aria-hidden="true">👋</div>
				<h2 class="dialog-title" id="name-prompt-title">What's your name?</h2>
				<p class="dialog-text">Other people in the line will see it. Leave it blank to be a guest.</p>
				<input @bind="nameInput" class="form-control dialog-input" maxlength="60" placeholder="Guest" autofocus aria-label="Your name" />
				<div class="dialog-actions">
					@if (myName is not null)
					{
						<button type="button" @onclick="() => showNamePrompt = false" class="btn btn-secondary btn-lg">✕ Cancel</button>
					}
					<button type="submit" class="btn btn-success btn-lg">Continue ➜</button>
				</div>
			</form>
		</div>
	}
}

@code {
	private string? newParticipant;

	[Inject]
	private ILineService LineService { get; set; } = null!;

	[Inject]
	private ILineChangeNotifier Notifier { get; set; } = null!;

	[Inject]
	private IJSRuntime JS { get; set; } = null!;

	[Inject]
	private ConfirmService ConfirmService { get; set; } = null!;

	[Inject]
	private NavigationManager NavigationManager { get; set; } = null!;

	[Parameter]
	public string LineId { get; set; } = null!;

	[Parameter]
	public string? ManageToken { get; set; }

	private LineDto? line;
	private bool canManage;
	private IDisposable? _subscription;
	private bool busy;
	private string? errorMessage;
	private string? myParticipantId;
	private string? myLeaveToken;
	private bool _hasSavedRecentLine;
	private bool shareLinkCopied;
	private bool manageLinkCopied;

	private enum PanelTab { Invite, Settings }
	private bool panelOpen;
	private PanelTab panelTab = PanelTab.Invite;

	/// <summary>Opens the side panel on a tab; pressing the button for the tab that's already open closes it.</summary>
	private void OpenPanel(PanelTab tab)
	{
		if (panelOpen && panelTab == tab)
		{
			panelOpen = false;
			return;
		}
		panelTab = tab;
		panelOpen = true;
	}

	private void ClosePanel() => panelOpen = false;

	private bool HasTimer => line is { AutoAdvanceLine: true } && line.AutoAdvanceInterval.TotalMinutes >= 1;

	private static string PeopleText(int count) => count switch
	{
		0 => "Nobody in line",
		1 => "1 person in line",
		_ => $"{count} people in line"
	};

	private static string AheadText(int count) => count == 1 ? "1 person ahead of you" : $"{count} people ahead of you";

	// Pause/resume, restart and reset. Shown under the clock and in the Settings panel.
	private RenderFragment TimerControls => @<div class="timer-controls">
		@if (line?.IsPaused == true)
		{
			<button @onclick="ResumeTimer" class="btn btn-success timer-btn" disabled="@busy">
				<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
				Resume timer
			</button>
		}
		else
		{
			<button @onclick="PauseTimer" class="btn btn-secondary timer-btn" disabled="@busy">
				<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor" /></svg>
				Pause timer
			</button>
		}
		<button @onclick="RestartTimer" class="btn btn-secondary timer-btn" disabled="@busy">
			<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z" fill="currentColor" /></svg>
			Restart timer
		</button>
		@if (line?.IsPaused == true)
		{
			<button @onclick="ResetTimer" class="btn btn-secondary timer-btn" disabled="@busy">
				<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h2v12H6zM9.5 12 18 18V6z" fill="currentColor" /></svg>
				Reset timer
			</button>
		}
	</div>;

	// Browser-remembered identity: the display name is shared across lines; participation is per line
	private string? myName;
	private string? nameInput;
	private bool showNamePrompt;

	/// <summary>1-based place in line, or null if this browser's participant isn't actively in line.</summary>
	private int? MyPosition
	{
		get
		{
			if (line is null || myParticipantId is null)
			{
				return null;
			}
			var index = line.Participants.OrderBy(p => p.Position).ToList().FindIndex(p => p.Id == myParticipantId);
			return index < 0 ? null : index + 1;
		}
	}

	private bool historyCollapsed;

	private string ShareLink =>NavigationManager.ToAbsoluteUri($"/view-line/{LineId}").ToString();

	private class MyParticipation
	{
		[System.Text.Json.Serialization.JsonPropertyName("participantId")]
		public string ParticipantId { get; set; } = "";
		[System.Text.Json.Serialization.JsonPropertyName("leaveToken")]
		public string LeaveToken { get; set; } = "";
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			// Validate manage token if provided
			if (!string.IsNullOrEmpty(ManageToken))
			{
				canManage = await LineService.ValidateManageTokenAsync(LineId, ManageToken);
			}
			else
			{
				canManage = false;
			}

			// Load the line
			var lineData = await LineService.GetLineAsync(LineId);
			if (lineData is null)
			{
				errorMessage = "Line not found.";
				return;
			}

			line = lineData;

			// Subscribe to line changes
			_subscription = Notifier.Subscribe(LineId, OnLineChanged);
		}
		catch (Exception ex)
		{
			errorMessage = "Error loading line.";
			Console.WriteLine($"Error in OnInitializedAsync: {ex}");
		}
	}

	private async Task OnLineChanged(LineDto dto)
	{
		await InvokeAsync(() =>
		{
			line = dto;
			// Advanced off the line (or removed by the manager): offer "Hop in line" again
			if (myParticipantId is not null && !dto.Participants.Any(p => p.Id == myParticipantId))
			{
				myParticipantId = null;
				myLeaveToken = null;
			}
			StateHasChanged();
		});
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_hasSavedRecentLine && line is not null)
		{
			_hasSavedRecentLine = true;
			try
			{
				await JS.InvokeVoidAsync("hopInLine.saveRecentLine", new
				{
					lineId = LineId,
					name = line.Name,
					role = canManage ? "manage" : "view",
					link = NavigationManager.Uri
				});

				myName = await JS.InvokeAsync<string?>("hopInLine.getDisplayName");
				if (string.IsNullOrWhiteSpace(myName))
				{
					myName = null;
					OpenNamePrompt();
				}

				// Restore "who am I in this line" after refresh / reopening the browser
				var participation = await JS.InvokeAsync<MyParticipation?>("hopInLine.getMyParticipation", LineId);
				if (participation is not null && line.Participants.Any(p => p.Id == participation.ParticipantId))
				{
					myParticipantId = participation.ParticipantId;
					myLeaveToken = participation.LeaveToken;
				}
				StateHasChanged();
			}
			catch
			{
				// JS interop unavailable — skip these convenience features
			}
		}

		if (line is not null)
		{
			if (line.AutoAdvanceLine && line.NextAdvanceAt.HasValue)
			{
				var delayEnd = line.DelayEndsAt.HasValue && !line.IsPaused
					? DateTime.SpecifyKind(line.DelayEndsAt.Value, DateTimeKind.Utc).ToString("O")
					: null;
				await JS.InvokeVoidAsync("hopInLine.startCountdown", $"countdown-{LineId}", DateTime.SpecifyKind(line.NextAdvanceAt.Value, DateTimeKind.Utc).ToString("O"),
					delayEnd, DelayLabel, $"status-{LineId}");
			}
			else if (line.AutoAdvanceLine)
			{
				await JS.InvokeVoidAsync("hopInLine.stopCountdown", $"countdown-{LineId}");
			}
		}
	}

	private string DelayLabel => line?.DelayIsStartCountdown == true ? "Starting in" : "Next up in";

	private bool InDelay => line is { IsPaused: false, DelayEndsAt: not null } && line.DelayEndsAt.Value > DateTime.UtcNow;

	private string GetStatusLabel() => line?.IsPaused == true ? "Paused" : InDelay ? DelayLabel : "Time left";

	private string GetTimeLeftDisplay()
	{
		if (line is null)
		{
			return "Loading...";
		}

		if (InDelay)
		{
			return DurationFormat.Humanize(line.DelayEndsAt!.Value - DateTime.UtcNow);
		}

		if (line.IsPaused && line.UnpauseRemaining.HasValue)
		{
			return DurationFormat.Humanize(line.UnpauseRemaining.Value);
		}
		else if (line.IsPaused)
		{
			// Nothing stored: Resume starts a full interval, so show that
			return DurationFormat.Humanize(line.AutoAdvanceInterval);
		}
		else if (line.NextAdvanceAt.HasValue)
		{
			var remainingTime = line.NextAdvanceAt.Value - DateTime.UtcNow;
			if (remainingTime <= TimeSpan.Zero)
			{
				return "Auto-advance happening now...";
			}
			return DurationFormat.Humanize(remainingTime);
		}

		return "Loading...";
	}

	private void OpenNamePrompt()
	{
		nameInput = myName;
		showNamePrompt = true;
	}

	private async Task SaveName()
	{
		// Blank is fine — the user becomes a guest
		myName = string.IsNullOrWhiteSpace(nameInput)
			? $"Guest {Random.Shared.Next(100, 1000)}"
			: nameInput.Trim();
		showNamePrompt = false;
		try
		{
			await JS.InvokeVoidAsync("hopInLine.saveDisplayName", myName);
		}
		catch
		{
			// JS interop unavailable — the name lasts for this session only
		}
	}

	private async Task JoinLine()
	{
		if (myName is null)
		{
			OpenNamePrompt();
			return;
		}

		await AddParticipant(myName, async result =>
		{
			myParticipantId = result.ParticipantId;
			myLeaveToken = result.LeaveToken;
			try
			{
				await JS.InvokeVoidAsync("hopInLine.saveMyParticipation", LineId, result.ParticipantId, result.LeaveToken);
			}
			catch
			{
				// JS interop unavailable — the leave button will still work this session via in-memory state
			}
		});
	}

	private async Task AddOther()
	{
		if (string.IsNullOrWhiteSpace(newParticipant))
		{
			return;
		}

		// Someone else added by the manager — not this browser's identity
		await AddParticipant(newParticipant.Trim(), _ =>
		{
			newParticipant = string.Empty;
			return Task.CompletedTask;
		});
	}

	private async Task AddParticipant(string name, Func<ParticipantJoinResult, Task> onAdded)
	{
		if (line is null)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			var result = await LineService.AddParticipantAsync(LineId, name, ManageToken);
			await onAdded(result);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

