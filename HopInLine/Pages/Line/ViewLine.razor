	private ParticipantDto? renameTarget;
	private string? renameInput;
	private string? renameError;

	private void OpenRenamePrompt(ParticipantDto participant)
	{
		renameTarget = participant;
		renameInput = participant.Name;
		renameError = null;
	}

	private void CloseRenamePrompt()
	{
		renameTarget = null;
		renameError = null;
	}

	private async Task SaveRename()
	{
		if (renameTarget is not { } target)
		{
			return;
		}

		var name = renameInput?.Trim() ?? "";
		if (name.Length == 0)
		{
			renameError = "Please type a name.";
			return;
		}
		if (name == target.Name)
		{
			CloseRenamePrompt();
			return;
		}

		await RunManagerActionAsync(() => LineService.RenameParticipantAsync(LineId, ManageToken ?? string.Empty, target.Id, name));

		// Keep the dialog open on failure so the manager can fix it and retry
		if (string.IsNullOrEmpty(errorMessage))
		{
			CloseRenamePrompt();
		}
		else
		{
			renameError = errorMessage;
			errorMessage = null;
		}
	}

	private ParticipantDto? noteTarget;
	private bool noteIsSelf;
	private string? noteInput;
	private string? noteError;

	private void OpenNotePrompt(ParticipantDto participant, bool isSelf)
	{
		noteTarget = participant;
		noteIsSelf = isSelf;
		noteInput = participant.Description;
		noteError = null;
	}

	private void OpenOwnNotePrompt()
	{
		var me = line?.Participants.FirstOrDefault(p => p.Id == myParticipantId);
		if (me is not null)
		{
			OpenNotePrompt(me, isSelf: true);
		}
	}

	private void CloseNotePrompt()
	{
		noteTarget = null;
		noteError = null;
	}

	private async Task SaveNote()
	{
		if (noteTarget is not { } target)
		{
			return;
		}

		var note = noteInput?.Trim() ?? "";
		if (note == (target.Description ?? ""))
		{
			CloseNotePrompt();
			return;
		}

		busy = true;
		noteError = null;
		try
		{
			if (noteIsSelf)
			{
				if (string.IsNullOrEmpty(myParticipantId) || string.IsNullOrEmpty(myLeaveToken))
				{
					noteError = "You're not in this line anymore.";
					return;
				}
				await LineService.SetOwnNoteAsync(LineId, myParticipantId, myLeaveToken, note);
			}
			else if (canManage)
			{
				await LineService.SetParticipantNoteAsync(LineId, ManageToken ?? string.Empty, target.Id, note);
			}
			CloseNotePrompt();
		}
		catch (ArgumentException ex)
		{
			noteError = ex.Message;
		}
		catch (KeyNotFoundException)
		{
			noteError = noteIsSelf ? "You're not in this line anymore." : "That person isn't in this line anymore.";
		}
		catch (UnauthorizedAccessException)
		{
			noteError = "You don't have permission to change this note.";
		}
		catch (RateLimitExceededException ex)
		{
			noteError = ex.Message;
		}
		catch (DbUpdateConcurrencyException)
		{
			noteError = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			noteError = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

