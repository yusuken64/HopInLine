	public async ValueTask DisposeAsync()
	{
		_subscription?.Dispose();
		if (line is not null)
		{
			try
			{
				await JS.InvokeVoidAsync("hopInLine.stopCountdown", $"countdown-{LineId}");
			}
			catch
			{
				// JS runtime may not be available during disposal
			}
		}
	}
