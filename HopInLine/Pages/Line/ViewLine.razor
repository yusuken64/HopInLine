@page "/view-line/{LineId}"
@page "/manage/{LineId}/{ManageToken}"
@using HopInLine.Data.Line;
@using Microsoft.EntityFrameworkCore;
@implements IAsyncDisposable

@if (line == null)
{
	if (string.IsNullOrEmpty(errorMessage))
	{
		<p>Loading...</p>
	}
	else
	{
		<p>@errorMessage</p>
		<a href="/">Go to home page</a>
	}
}
else
{
	<aside class="side-panel @(panelOpen ? "open" : "")" aria-label="Line panel">
		<button class="side-panel-toggle" @onclick="TogglePanel"
				aria-expanded="@(panelOpen ? "true" : "false")"
				aria-label="@(panelOpen ? "Close panel" : (canManage ? "Open invite and settings panel" : "Open invite panel"))">
			<span class="oi @(panelOpen ? "oi-chevron-left" : "oi-chevron-right")" aria-hidden="true"></span>
		</button>

		<div class="side-panel-body">
			@if (panelTab == PanelTab.Invite)
			{
				<h2 class="side-panel-heading">Invite people</h2>
				<p class="text-muted">Anyone with this link can see the line and hop in.</p>
				<input class="form-control" readonly value="@ShareLink" aria-label="Join link" />
				<div class="side-panel-row">
					<button @onclick="CopyShareLink" class="btn btn-primary">@(shareLinkCopied ? "Copied!" : "Copy link")</button>
					<span class="text-muted">or code <strong>@line.Id</strong></span>
				</div>

				@if (canManage)
				{
					<h2 class="side-panel-heading">Add someone</h2>
					<p class="text-muted">For people who aren't on a device.</p>
					<form class="side-panel-row" @onsubmit="AddOther" @onsubmit:preventDefault>
						<input @bind="newParticipant" placeholder="Name" maxlength="60" class="form-control" disabled="@busy" aria-label="Name to add" />
						<button type="submit" class="btn btn-outline-success" disabled="@busy">Add</button>
					</form>

					<h2 class="side-panel-heading">Manage link</h2>
					<p class="text-muted">Bookmark this page — this URL is the only way back in as manager. Don't share it.</p>
					<button @onclick="CopyManageLink" class="btn btn-secondary">@(manageLinkCopied ? "Copied!" : "Copy manage link")</button>
				}
			}
			else if (panelTab == PanelTab.Settings && canManage)
			{
				@if (line.AutoAdvanceLine && line.AutoAdvanceInterval.TotalMinutes >= 1)
				{
					<h2 class="side-panel-heading">Timer</h2>
					<p class="text-muted">Advances every @DurationFormat.Humanize(line.AutoAdvanceInterval).</p>
					<div class="side-panel-row">
						@if (line.IsPaused)
						{
							<button @onclick="ResumeTimer" class="btn btn-secondary timer-btn" disabled="@busy">
								<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
								Resume timer
							</button>
						}
						else
						{
							<button @onclick="PauseTimer" class="btn btn-secondary timer-btn" disabled="@busy">
								<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor" /></svg>
								Pause timer
							</button>
						}
						<button @onclick="RestartTimer" class="btn btn-secondary timer-btn" disabled="@busy">
							<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z" fill="currentColor" /></svg>
							Restart timer
						</button>
						@if (line.IsPaused)
						{
							<button @onclick="ResetTimer" class="btn btn-secondary timer-btn" disabled="@busy">
								<svg class="timer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h2v12H6zM9.5 12 18 18V6z" fill="currentColor" /></svg>
								Reset timer
							</button>
						}
					</div>
				}

				<h2 class="side-panel-heading">Line settings</h2>
				<button @onclick="Edit" class="btn btn-secondary" disabled="@busy">Edit line</button>

				<h2 class="side-panel-heading">Danger zone</h2>
				<button @onclick="DeleteLineAsync" class="btn btn-outline-danger" disabled="@busy">Delete line</button>
			}
		</div>

		@if (canManage)
		{
			<nav class="side-panel-tabs" role="tablist">
				<button role="tab" aria-selected="@(panelTab == PanelTab.Invite ? "true" : "false")"
						class="side-panel-tab @(panelTab == PanelTab.Invite ? "active" : "")"
						@onclick="() => panelTab = PanelTab.Invite">
					<span class="oi oi-people" aria-hidden="true"></span> Invite
				</button>
				<button role="tab" aria-selected="@(panelTab == PanelTab.Settings ? "true" : "false")"
						class="side-panel-tab @(panelTab == PanelTab.Settings ? "active" : "")"
						@onclick="() => panelTab = PanelTab.Settings">
					<span class="oi oi-cog" aria-hidden="true"></span> Settings
				</button>
			</nav>
		}
	</aside>

	<div class="view-line-shell @(panelOpen ? "panel-open" : "")">
		<div>
			<h1 style="margin: 0;">@line.Name @if (line.Participants is { Count: > 0 }) {<span class="history-count" title="People in line">(@line.Participants.Count)</span>}</h1>

			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger" role="alert">@errorMessage</div>
			}

			<div class="participants-list">
				@if (line.Participants == null || line.Participants.Count == 0)
				{
					<p>No one's in line yet — add the first person below.</p>
				}
				else
				{
					var firstActiveId = line.Participants.Where(p => !p.Removed).OrderBy(p => p.Position).FirstOrDefault()?.Id;
					@if (line.AutoAdvanceLine)
					{
						var nowUp = line.Participants.FirstOrDefault(p => p.Id == firstActiveId)?.Name;
						<section class="scoreboard @(line.IsPaused ? "paused" : "")" aria-label="Turn timer">
							@if (nowUp is not null)
							{
								<div class="scoreboard-label">Now up</div>
								<div class="scoreboard-name">@nowUp</div>
							}
							<div class="scoreboard-clock" id="countdown-@line.Id" role="timer">@GetTimeLeftDisplay()</div>
							<div class="scoreboard-status">
								<span class="scoreboard-light" aria-hidden="true"></span>
								@(line.IsPaused ? "Paused" : "Time left")
							</div>
						</section>
					}
					@foreach (var participant in line.Participants.OrderBy(x => x.Position))
					{
						@if (canManage)
						{
							<ParticipantCard @key="participant.Id"
							Name="@participant.Name"
							Description="@participant.Description"
							Id="@participant.Id"
							BackgroundColor="@participant.Color"
							TurnCount="@participant.TurnCount"
							IsCurrentTurn="@(participant.Id == firstActiveId)"
							OnMoveUp="@(async () => await MoveParticipantUp(participant))"
							OnMoveDown="@(async () => await MoveParticipantDown(participant))"
							OnRemove="@(async () => await RemoveParticipant(participant))" />
						}
						else
						{
							<ParticipantCard @key="participant.Id"
							Name="@participant.Name"
							Description="@participant.Description"
							Id="@participant.Id"
							BackgroundColor="@participant.Color"
							TurnCount="@participant.TurnCount"
							IsCurrentTurn="@(participant.Id == firstActiveId)"
							OnMoveUp="@(async () => await Task.CompletedTask)"
							OnMoveDown="@(async () => await Task.CompletedTask)"
							OnRemove="@(async () => await Task.CompletedTask)" />
						}
					}
				}
			</div>

			<h2 class="history-heading">
				<button type="button" class="history-toggle" @onclick="() => historyCollapsed = !historyCollapsed" aria-expanded="@(!historyCollapsed)">
					<span class="history-chevron @(historyCollapsed ? "collapsed" : "")" aria-hidden="true">▾</span>
					Removed Participants History
					@if (line.RemovedParticipants is { Count: > 0 })
					{
						<span class="history-count">(@line.RemovedParticipants.Count)</span>
					}
				</button>
			</h2>
			@if (historyCollapsed)
			{
			}
			else if (line.RemovedParticipants == null || line.RemovedParticipants.Count == 0)
			{
				<p>History shows up here once someone's had a turn.</p>
			}
			else
			{
				@foreach (var participant in line.RemovedParticipants.OrderBy(x => x.Position))
				{
					@if (canManage)
					{
						<RemovedParticipantCard @key="participant.Id"
							Name="@participant.Name"
							Description="@participant.Description"
							Id="@participant.Id"
							BackgroundColor="@participant.Color"
							TurnCount="@participant.TurnCount"
							OnReAdd="@(async () => await ReAddRemovedParticipant(participant))"
							OnDelete="@(async () => await DeleteRemovedParticipant(participant))" />
					}
					else
					{
						<RemovedParticipantCard @key="participant.Id"
							Name="@participant.Name"
							Description="@participant.Description"
							Id="@participant.Id"
							BackgroundColor="@participant.Color"
							TurnCount="@participant.TurnCount"
							OnReAdd="@(async () => await Task.CompletedTask)"
							OnDelete="@(async () => await Task.CompletedTask)" />
					}
				}
			}
		</div>

		<div class="toolbar">
			<div class="toolbar-me">
				<span>
					You're <strong>@(myName ?? "...")</strong>
					<button @onclick="OpenNamePrompt" class="btn btn-link btn-sm">change</button>
				</span>
				@if (MyPosition is int position)
				{
					<span>— #@position in line</span>
					<button @onclick="LeaveLine" class="btn btn-secondary" disabled="@busy">Leave line</button>
				}
				else
				{
					<button @onclick="JoinLine" class="btn btn-success" disabled="@(busy || myName is null)">Hop in line</button>
				}
			</div>
			@if (canManage)
			{
				<div class="toolbar-input">
					<button @onclick="AdvanceLine" class="btn btn-warning" disabled="@busy">Advance</button>
				</div>
			}
		</div>
	</div>

	@if (showNamePrompt)
	{
		<div class="name-prompt-backdrop">
			<form class="name-prompt" role="dialog" aria-modal="true" aria-labelledby="name-prompt-title"
				  @onsubmit="SaveName" @onsubmit:preventDefault>
				<h2 id="name-prompt-title">What's your name?</h2>
				<p class="text-muted">Shown to others when you're in line. Leave blank to be a guest.</p>
				<input @bind="nameInput" class="form-control" maxlength="60" placeholder="Guest" autofocus />
				<div class="name-prompt-actions">
					@if (myName is not null)
					{
						<button type="button" @onclick="() => showNamePrompt = false" class="btn btn-secondary">Cancel</button>
					}
					<button type="submit" class="btn btn-primary">Continue</button>
				</div>
			</form>
		</div>
	}
}

@code {
	private string? newParticipant;

	[Inject]
	private ILineService LineService { get; set; } = null!;

	[Inject]
	private ILineChangeNotifier Notifier { get; set; } = null!;

	[Inject]
	private IJSRuntime JS { get; set; } = null!;

	[Inject]
	private ConfirmService ConfirmService { get; set; } = null!;

	[Inject]
	private NavigationManager NavigationManager { get; set; } = null!;

	[Parameter]
	public string LineId { get; set; } = null!;

	[Parameter]
	public string? ManageToken { get; set; }

	private LineDto? line;
	private bool canManage;
	private IDisposable? _subscription;
	private bool busy;
	private string? errorMessage;
	private string? myParticipantId;
	private string? myLeaveToken;
	private bool _hasSavedRecentLine;
	private bool shareLinkCopied;
	private bool manageLinkCopied;

	private enum PanelTab { Invite, Settings }
	private bool panelOpen;
	private PanelTab panelTab = PanelTab.Invite;

	private void TogglePanel() => panelOpen = !panelOpen;

	// Browser-remembered identity: the display name is shared across lines; participation is per line
	private string? myName;
	private string? nameInput;
	private bool showNamePrompt;

	/// <summary>1-based place in line, or null if this browser's participant isn't actively in line.</summary>
	private int? MyPosition
	{
		get
		{
			if (line is null || myParticipantId is null)
			{
				return null;
			}
			var index = line.Participants.OrderBy(p => p.Position).ToList().FindIndex(p => p.Id == myParticipantId);
			return index < 0 ? null : index + 1;
		}
	}

	private bool historyCollapsed;

	private string ShareLink =>NavigationManager.ToAbsoluteUri($"/view-line/{LineId}").ToString();

	private class MyParticipation
	{
		[System.Text.Json.Serialization.JsonPropertyName("participantId")]
		public string ParticipantId { get; set; } = "";
		[System.Text.Json.Serialization.JsonPropertyName("leaveToken")]
		public string LeaveToken { get; set; } = "";
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			// Validate manage token if provided
			if (!string.IsNullOrEmpty(ManageToken))
			{
				canManage = await LineService.ValidateManageTokenAsync(LineId, ManageToken);
			}
			else
			{
				canManage = false;
			}

			// Load the line
			var lineData = await LineService.GetLineAsync(LineId);
			if (lineData is null)
			{
				errorMessage = "Line not found.";
				return;
			}

			line = lineData;

			// Subscribe to line changes
			_subscription = Notifier.Subscribe(LineId, OnLineChanged);
		}
		catch (Exception ex)
		{
			errorMessage = "Error loading line.";
			Console.WriteLine($"Error in OnInitializedAsync: {ex}");
		}
	}

	private async Task OnLineChanged(LineDto dto)
	{
		await InvokeAsync(() =>
		{
			line = dto;
			// Advanced off the line (or removed by the manager): offer "Hop in line" again
			if (myParticipantId is not null && !dto.Participants.Any(p => p.Id == myParticipantId))
			{
				myParticipantId = null;
				myLeaveToken = null;
			}
			StateHasChanged();
		});
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_hasSavedRecentLine && line is not null)
		{
			_hasSavedRecentLine = true;
			try
			{
				await JS.InvokeVoidAsync("hopInLine.saveRecentLine", new
				{
					lineId = LineId,
					name = line.Name,
					role = canManage ? "manage" : "view",
					link = NavigationManager.Uri
				});

				myName = await JS.InvokeAsync<string?>("hopInLine.getDisplayName");
				if (string.IsNullOrWhiteSpace(myName))
				{
					myName = null;
					OpenNamePrompt();
				}

				// Restore "who am I in this line" after refresh / reopening the browser
				var participation = await JS.InvokeAsync<MyParticipation?>("hopInLine.getMyParticipation", LineId);
				if (participation is not null && line.Participants.Any(p => p.Id == participation.ParticipantId))
				{
					myParticipantId = participation.ParticipantId;
					myLeaveToken = participation.LeaveToken;
				}
				StateHasChanged();
			}
			catch
			{
				// JS interop unavailable — skip these convenience features
			}
		}

		if (line is not null)
		{
			if (line.AutoAdvanceLine && line.NextAdvanceAt.HasValue)
			{
				await JS.InvokeVoidAsync("hopInLine.startCountdown", $"countdown-{LineId}", DateTime.SpecifyKind(line.NextAdvanceAt.Value, DateTimeKind.Utc).ToString("O"));
			}
			else if (line.AutoAdvanceLine)
			{
				await JS.InvokeVoidAsync("hopInLine.stopCountdown", $"countdown-{LineId}");
			}
		}
	}

	private string GetTimeLeftDisplay()
	{
		if (line is null)
		{
			return "Loading...";
		}

		if (line.IsPaused && line.UnpauseRemaining.HasValue)
		{
			return DurationFormat.Humanize(line.UnpauseRemaining.Value);
		}
		else if (line.IsPaused)
		{
			// Nothing stored: Resume starts a full interval, so show that
			return DurationFormat.Humanize(line.AutoAdvanceInterval);
		}
		else if (line.NextAdvanceAt.HasValue)
		{
			var remainingTime = line.NextAdvanceAt.Value - DateTime.UtcNow;
			if (remainingTime <= TimeSpan.Zero)
			{
				return "Auto-advance happening now...";
			}
			return DurationFormat.Humanize(remainingTime);
		}

		return "Loading...";
	}

	private void OpenNamePrompt()
	{
		nameInput = myName;
		showNamePrompt = true;
	}

	private async Task SaveName()
	{
		// Blank is fine — the user becomes a guest
		myName = string.IsNullOrWhiteSpace(nameInput)
			? $"Guest {Random.Shared.Next(100, 1000)}"
			: nameInput.Trim();
		showNamePrompt = false;
		try
		{
			await JS.InvokeVoidAsync("hopInLine.saveDisplayName", myName);
		}
		catch
		{
			// JS interop unavailable — the name lasts for this session only
		}
	}

	private async Task JoinLine()
	{
		if (myName is null)
		{
			OpenNamePrompt();
			return;
		}

		await AddParticipant(myName, async result =>
		{
			myParticipantId = result.ParticipantId;
			myLeaveToken = result.LeaveToken;
			try
			{
				await JS.InvokeVoidAsync("hopInLine.saveMyParticipation", LineId, result.ParticipantId, result.LeaveToken);
			}
			catch
			{
				// JS interop unavailable — the leave button will still work this session via in-memory state
			}
		});
	}

	private async Task AddOther()
	{
		if (string.IsNullOrWhiteSpace(newParticipant))
		{
			return;
		}

		// Someone else added by the manager — not this browser's identity
		await AddParticipant(newParticipant.Trim(), _ =>
		{
			newParticipant = string.Empty;
			return Task.CompletedTask;
		});
	}

	private async Task AddParticipant(string name, Func<ParticipantJoinResult, Task> onAdded)
	{
		if (line is null)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			var result = await LineService.AddParticipantAsync(LineId, name, ManageToken);
			await onAdded(result);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task AdvanceLine()
	{
		if (line is null || !canManage)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.AdvanceLineAsync(LineId, ManageToken ?? string.Empty);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task MoveParticipantUp(ParticipantDto participant)
	{
		if (line is null || !canManage)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.MoveParticipantUpAsync(LineId, ManageToken ?? string.Empty, participant.Id);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task MoveParticipantDown(ParticipantDto participant)
	{
		if (line is null || !canManage)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.MoveParticipantDownAsync(LineId, ManageToken ?? string.Empty, participant.Id);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task RemoveParticipant(ParticipantDto participant)
	{
		if (line is null || !canManage)
		{
			return;
		}

		if (!await ConfirmService.ConfirmAsync($"Remove {participant.Name}?"))
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.RemoveParticipantAsync(LineId, ManageToken ?? string.Empty, participant.Id);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task CopyShareLink()
	{
		shareLinkCopied = await JS.InvokeAsync<bool>("hopInLine.copyToClipboard", ShareLink);
	}

	private async Task CopyManageLink()
	{
		manageLinkCopied = await JS.InvokeAsync<bool>("hopInLine.copyToClipboard", NavigationManager.Uri);
	}

	private async Task LeaveLine()
	{
		if (line is null || string.IsNullOrEmpty(myParticipantId) || string.IsNullOrEmpty(myLeaveToken))
		{
			return;
		}

		if (!await ConfirmService.ConfirmAsync("Leave this line?"))
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.RemoveSelfAsync(LineId, myParticipantId, myLeaveToken);
			myParticipantId = null;
			myLeaveToken = null;
		}
		catch (KeyNotFoundException)
		{
			errorMessage = "You are no longer in this line.";
			myParticipantId = null;
			myLeaveToken = null;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to leave this line.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

