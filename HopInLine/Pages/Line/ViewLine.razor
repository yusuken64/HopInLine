		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task Edit()
	{
		NavigationManager.NavigateTo($"/manage/{LineId}/{ManageToken}/edit");
	}

	private async Task ResumeTimer(MouseEventArgs args)
	{
		if (line is null || !canManage)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.ResumeTimerAsync(LineId, ManageToken ?? string.Empty);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
			errorMessage = "Someone else just updated this line — please try again.";
		}
		catch (Exception ex)
		{
			errorMessage = $"An unexpected error occurred: {ex.Message}";
		}
		finally
		{
			busy = false;
		}
	}

	private async Task PauseTimer(MouseEventArgs args)
	{
		if (line is null || !canManage)
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.PauseTimerAsync(LineId, ManageToken ?? string.Empty);
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
