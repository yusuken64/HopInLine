	private async Task DeleteLineAsync()
	{
		if (line is null || !canManage)
		{
			return;
		}

		if (!await ConfirmService.ConfirmAsync($"Delete line '{line.Name}'? This cannot be undone."))
		{
			return;
		}

		busy = true;
		errorMessage = null;
		try
		{
			await LineService.DeleteLineAsync(LineId, ManageToken ?? string.Empty);
			NavigationManager.NavigateTo("/");
		}
		catch (ArgumentException ex)
		{
			errorMessage = ex.Message;
		}
		catch (InvalidOperationException ex)
		{
			errorMessage = ex.Message;
		}
		catch (UnauthorizedAccessException)
		{
			errorMessage = "You no longer have permission to manage this line.";
		}
		catch (DbUpdateConcurrencyException)
		{
