@page "/"
@namespace HopInLine.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}

@* The client IP is captured here because HttpContext is not reliably available inside a Blazor circuit *@
<component type="typeof(App)" render-mode="Server" param-ClientIp="@(HttpContext.Connection.RemoteIpAddress?.ToString())" />
