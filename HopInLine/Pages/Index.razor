@page "/"
@using HopInLine.Data.Line;

<div class="page">
    <div class="home-intro">
        <h1 class="page-title">Hop In Line</h1>
        <p class="page-subtitle">Take turns without the chaos. No sign-up. Nothing to install.</p>
    </div>

    <div class="home-doors">
        <section class="page-card home-door home-door-start" aria-labelledby="start-heading">
            <div class="home-door-head">
                <div class="home-door-icon" aria-hidden="true">✨</div>
                <h2 id="start-heading">Start a new line</h2>
            </div>
            <p class="home-door-text">You're in charge. You'll get a link to share.</p>
            <button @onclick="NavigateToStartLine" class="btn btn-warning btn-lg btn-wide">Start a line</button>
        </section>

        <section class="page-card home-door home-door-join" aria-labelledby="join-heading">
            <div class="home-door-head">
                <div class="home-door-icon" aria-hidden="true">🎟️</div>
                <h2 id="join-heading">Join a line</h2>
            </div>
            <form class="home-join-form" @onsubmit="NavigateToJoinLine" @onsubmit:preventDefault>
                <label for="lineId" class="form-label">Type the code you were given</label>
                <input @bind="lineID" id="lineId" class="form-control code-input" placeholder="Line code"
                       autocomplete="off" autocapitalize="characters" spellcheck="false"
                       aria-describedby="@(joinError != null ? "join-error" : null)" />
                @if (joinError != null)
                {
                    <div class="alert alert-danger" role="alert" id="join-error">@joinError</div>
                }
                <button type="submit" class="btn btn-success btn-lg btn-wide">Join</button>
            </form>
        </section>
    </div>

    @if (recentLines.Count > 0)
    {
        <section class="page-card" aria-labelledby="recent-heading">
            <h2 id="recent-heading">Your lines</h2>
            <p class="recent-hint">Lines you opened on this device. Tap one to go back to it.</p>
            <ul class="recent-lines">
                @foreach (var entry in recentLines)
                {
                    <li>
                        <a class="recent-line" href="@entry.Link">
                            <span class="recent-line-name">@entry.Name</span>
                            @if (entry.Role == "manage")
                            {
                                <span class="tag tag-yellow">👑 You run this</span>
                            }
                            else
                            {
                                <span class="tag tag-blue">👀 You visited</span>
                            }
                            <span class="recent-line-go" aria-hidden="true">➜</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    [Inject]
    private ILineService LineService { get; set; } = default!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]private OverlayService OverlayService { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private string lineID = "";
    private string? joinError;

    private List<RecentLineEntry> recentLines = new();
    private bool _recentLinesLoaded;

    private void NavigateToStartLine()
    {
        // Navigate to the "Start A Line" page
        NavigationManager.NavigateTo("/start-line");
    }

    private async Task NavigateToJoinLine()
    {
        joinError = null;

        OverlayService.ShowOverlay();
        try
        {
            var code = IdGenerator.NormalizeId(lineID ?? string.Empty);

            if (string.IsNullOrEmpty(code))
            {
                joinError = "Enter a line code.";
                StateHasChanged();
                return;
            }

            var line = await LineService.GetLineAsync(code);

            if (line == null)
            {
                joinError = $"No line found with code \"{code}\".";
                StateHasChanged();
                return;
            }

            NavigationManager.NavigateTo($"/view-line/{line.Id}");
        }
        finally
        {
            OverlayService.HideOverlay();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_recentLinesLoaded)
        {
            _recentLinesLoaded = true;
            try
            {
                var result = await JS.InvokeAsync<List<RecentLineEntry>>("hopInLine.getRecentLines");
                recentLines = result ?? new();
                StateHasChanged();
            }
            catch
            {
                recentLines = new();
            }
        }
    }

    private class RecentLineEntry
    {
        [System.Text.Json.Serialization.JsonPropertyName("lineId")]
        public string LineId { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("role")]
        public string Role { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("link")]
        public string Link { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("savedAt")]
        public string SavedAt { get; set; } = "";
    }
}