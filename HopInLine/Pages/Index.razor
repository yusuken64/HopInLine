@page "/"
@using HopInLine.Data.Line;

<h1>Hop In Line</h1>

<h3>Track who's next — no sign-up, no setup. One click and share the link.</h3>

<div class="mb-4">
    <button @onclick="NavigateToStartLine" class="btn btn-primary btn-lg">Start A Line</button>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Join a Line</h5>
        <form @onsubmit="NavigateToJoinLine" @onsubmit:preventDefault>
            <div class="mb-3">
                <label for="lineId" class="form-label">Enter Line ID:</label>
                <input @bind="lineID" id="lineId" class="form-control" placeholder="Enter the Line ID here" @aria-describedby="joinError != null ? "join-error" : null" />
            </div>
            @if (joinError != null)
            {
                <div class="alert alert-danger" role="alert" id="join-error">@joinError</div>
            }
            <button type="submit" class="btn btn-secondary btn-lg">Join</button>
        </form>
    </div>
</div>

@if (recentLines.Count > 0)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Your lines</h5>
            <ul class="list-group">
                @foreach (var entry in recentLines)
                {
                    <li class="list-group-item">
                        <a href="@entry.Link">@entry.Name</a>
                        <span class="text-muted">(@(entry.Role == "manage" ? "manager" : "viewer"))</span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    [Inject]
    private ILineService LineService { get; set; } = default!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]private OverlayService OverlayService { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private string lineID = "";
    private string? joinError;

    private List<RecentLineEntry> recentLines = new();
    private bool _recentLinesLoaded;

    private void NavigateToStartLine()
    {
        // Navigate to the "Start A Line" page
        NavigationManager.NavigateTo("/start-line");
    }

    private async Task NavigateToJoinLine()
    {
        joinError = null;

        OverlayService.ShowOverlay();
        try
        {
            var code = IdGenerator.NormalizeId(lineID ?? string.Empty);

            if (string.IsNullOrEmpty(code))
            {
                joinError = "Enter a line code.";
                StateHasChanged();
                return;
            }

            var line = await LineService.GetLineAsync(code);

            if (line == null)
            {
                joinError = $"No line found with code \"{code}\".";
                StateHasChanged();
                return;
            }

            NavigationManager.NavigateTo($"/view-line/{line.Id}");
        }
        finally
        {
            OverlayService.HideOverlay();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_recentLinesLoaded)
        {
            _recentLinesLoaded = true;
            try
            {
                var result = await JS.InvokeAsync<List<RecentLineEntry>>("hopInLine.getRecentLines");
                recentLines = result ?? new();
                StateHasChanged();
            }
            catch
            {
                recentLines = new();
            }
        }
    }

    private class RecentLineEntry
    {
        [System.Text.Json.Serialization.JsonPropertyName("lineId")]
        public string LineId { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("role")]
        public string Role { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("link")]
        public string Link { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("savedAt")]
        public string SavedAt { get; set; } = "";
    }
}