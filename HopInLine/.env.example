# Copy to .env in this directory and set strong passwords before running docker compose.
# sa is only used by the one-off migrate and db-setup services.
SA_PASSWORD=ChangeMe_StrongPassword123!
# Password for the least-privilege hopinline_app login the web app uses.
APP_DB_PASSWORD=ChangeMe_AppPassword456!

# Semicolon-separated host names the app answers to, e.g. hopinline.example.com
ALLOWED_HOSTS=localhost

# Set one of these if a load balancer or ingress sits in front of the app (IP, or CIDR like 10.0.0.0/8)
TRUSTED_PROXY=
TRUSTED_NETWORK=

# The bundled SQL Server uses a self-signed certificate. Set to False when pointing at a server with a trusted one.
DB_TRUST_SERVER_CERTIFICATE=True
