# Copy to .env next to docker-compose.yml. Every setting is optional; the defaults
# serve plain HTTP on port 8080.

# --- HTTPS with an automatic Let's Encrypt certificate ---------------------------
# 1. Point your domain's DNS at this server and open ports 80 and 443.
# 2. Fill in these four lines, then run: docker compose up -d
# COMPOSE_PROFILES=https
# DOMAIN=queue.example.com
# ALLOWED_HOSTS=queue.example.com
# HOPINLINE_BIND=127.0.0.1

# --- Other settings ---------------------------------------------------------------
# Port for plain HTTP
HOPINLINE_PORT=8080

# Image tag to run: "latest", or a release like "1.0.0"
HOPINLINE_VERSION=latest
